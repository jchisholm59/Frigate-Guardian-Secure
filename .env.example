# Login is always required — no env vars to set here. On first boot, if no
# account exists yet, WatchTower seeds one: username "admin", password
# "watchtower". Log in with that and change the password immediately
# (top-right Account menu). Additional accounts (admin or standard) can be
# added from there too. Accounts are stored in <data dir>/users.json.

# Gmail SMTP Configuration
GMAIL_USER=your-email@gmail.com
GMAIL_PASSWORD=your-google-app-password
GMAIL_RECIPIENT=recipient-email@gmail.com
GMAIL_SENDER_NAME=WatchTower NVR

# Webhook URLs (Optional)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx/xxx/xxx
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/xxx/xxx

# AI Configuration
GEMINI_API_KEY=your-gemini-api-key

# Local AI (Ollama)
# If OLLAMA_URL is provided, it will be used instead of Gemini.
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=llama3
