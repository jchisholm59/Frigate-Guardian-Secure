# Login (Optional) — set both to require a username/password to use the app.
# Leave unset to run without login protection (not recommended if this
# server is reachable by anyone other than you).
AUTH_USERNAME=admin
AUTH_PASSWORD=change-me

# Gmail SMTP Configuration
GMAIL_USER=your-email@gmail.com
GMAIL_PASSWORD=your-google-app-password
GMAIL_RECIPIENT=recipient-email@gmail.com
GMAIL_SENDER_NAME=WatchTower NVR

# Webhook URLs (Optional)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx/xxx/xxx
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/xxx/xxx

# AI Configuration
GEMINI_API_KEY=your-gemini-api-key

# Local AI (Ollama)
# If OLLAMA_URL is provided, it will be used instead of Gemini.
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=llama3
